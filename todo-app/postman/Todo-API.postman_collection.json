{
  "info": {
    "name": "Todo API",
    "description": "CRUD tests for the Todo List RESTful API (Express + TypeScript + PostgreSQL).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "todoId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Todo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/todos", "host": ["{{baseUrl}}"], "path": ["api", "todos"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy milk\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Has an id', () => pm.expect(json.id).to.be.a('number'));",
              "pm.test('is_done defaults to false', () => pm.expect(json.is_done).to.eql(false));",
              "pm.collectionVariables.set('todoId', json.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Todo - Validation Error (empty title)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/todos", "host": ["{{baseUrl}}"], "path": ["api", "todos"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "List Todos",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/todos", "host": ["{{baseUrl}}"], "path": ["api", "todos"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Todo By Id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "todos", "{{todoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Id matches requested id', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('todoId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Todo - Mark as done",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "todos", "{{todoId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_done\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('is_done is now true', () => pm.expect(pm.response.json().is_done).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Todo - Not Found",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/todos/999999", "host": ["{{baseUrl}}"], "path": ["api", "todos", "999999"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_done\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Todo",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "todos", "{{todoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Todo - Not Found",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/todos/{{todoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "todos", "{{todoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 (already deleted)', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
